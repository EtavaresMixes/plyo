{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "packages",
    "libsDir": "libs"
  },
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/vite.config.[jt]s",
      "!{projectRoot}/svelte.config.[jt]s"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true,
      "outputs": ["{projectRoot}/build", "{projectRoot}/dist"]
    },
    "serve": {
      "continuous": true,
      "cache": false
    }
  },
  "cacheDirectory": ".nx/cache",
  "maxCacheSize": "2GB",
  "analytics": false
}
